# Copiați acest fișier în `.env` și completați valorile.

# Conexiunea PostgreSQL (aplicație + migrări Prisma).
DATABASE_URL="postgresql://secretariat:secretariat@localhost:5432/secretariat?schema=public"

# Baza de date separată pentru testele de integrare (opțional; fără ea, testele de integrare sunt sărite).
TEST_DATABASE_URL="postgresql://secretariat:secretariat@localhost:5432/secretariat_test?schema=public"

# Cheia de semnare a sesiunilor Auth.js — generați una cu:  npx auth secret   sau   openssl rand -base64 32
AUTH_SECRET="schimbati-aceasta-valoare"

# Necesar când aplicația rulează în spatele unui reverse proxy (sau cu `next start` pe alt host decât localhost).
AUTH_TRUST_HOST=true

# Adresa publică a aplicației — folosită în linkurile de invitație și de resetare a parolei.
APP_URL="http://localhost:3000"

# Permite înregistrarea de biserici noi din pagina /inregistrare.
# Chiar și cu `false`, prima biserică poate fi înregistrată cât timp baza de date e goală.
ALLOW_SIGNUP=false

# Fusul orar pentru „azi” (statistici, calendar, date implicite în formulare).
APP_TIME_ZONE="Europe/Bucharest"
