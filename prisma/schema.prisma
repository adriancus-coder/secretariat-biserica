// Schema bazei de date pentru Secretariat Biserică.
//
// Convenții:
// - fiecare înregistrare de domeniu are `churchId`: datele fiecărei biserici sunt complet izolate
//   (vezi src/server/tenant-db.ts, care adaugă automat filtrul pe biserică în toate interogările);
// - numele câmpurilor de domeniu urmează modelul de date din prototip (nume, prenume, dataNasterii, ...);
// - textele opționale sunt șiruri goale (nu NULL), ca în prototip; datele calendaristice sunt `date`.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Organizație, utilizatori, acces
// ---------------------------------------------------------------------------

enum Role {
  ADMIN
  SECRETAR
  VIZUALIZARE
}

model Church {
  id               String  @id @default(cuid())
  nume             String
  /// Public address of the membership application form: /cerere/<slug> (a-z, 0-9, hyphens; 3-40 chars).
  slug             String  @unique
  /// Whether the public form accepts membership applications.
  applicationsOpen Boolean @default(false)
  /// Every user must use a second factor (users without one are sent to its setup at login).
  require2fa       Boolean @default(false)
  /// The public privacy notice (/confidentialitate/<slug>); "" = the built-in template.
  privacyText      String  @default("")
  /// The model notice version the church adopted ("1.1"), and when; "[data]" in the notice.
  privacyVersion   String    @default("")
  privacyAdoptedAt DateTime? @db.Date
  /// The Comunitate the church belongs to (Statut; addressee of the obligatory notices).
  comunitate       String    @default("")
  /// Reading scans with Claude (Anthropic) is off until an administrator accepts the processing terms.
  extractEnabled   Boolean @default(false)
  adresa           String  @default("")
  orgNr            String  @default("")
  telefon          String  @default("")
  email            String  @default("")
  pastor           String  @default("")
  secretar         String  @default("")
  /// Addresses preselected when the minutes are e-mailed (Setări → Organizația).
  pastorEmail      String  @default("")
  secretarEmail    String  @default("")

  // Nomenclatoare editabile. O listă goală înseamnă „valorile implicite” din aplicație.
  tipuriSedinte    String[] @default([])
  tipuriEvenimente String[] @default([])
  tipuriMentiuni   String[] @default([])
  gradeRudenie     String[] @default([])
  /// Attendance rule per meeting type: { "<tip>": "TOTI" | "COMITET" | "MANUAL" }. Missing = default (src/lib/attendance.ts).
  regulaPrezenta   Json     @default("{}")
  /// Meeting types that are a General Assembly (Statut art. 46); empty = the type named "Adunare generală".
  tipuriAG         String[] @default([])
  /// Meeting types whose minutes show the quorum line (default: none).
  tipuriCvorum     String[] @default([])
  /// Committee mandate (Statut art. 45): elected on, the minutes of the election (a meeting id, checked
  /// against the church on save; no FK), extended once by 5 years.
  comitetAlesLa           DateTime? @db.Date
  comitetAlegereMeetingId String?
  comitetPrelungit        Boolean   @default(false)
  /// Default page layout of the printed minutes (src/lib/page-layout.ts); {} = the built-in layout.
  pvLayout         Json     @default("{}")
  /// Default page layout of the registered documents (src/lib/page-layout.ts); {} = the standard layout.
  docLayout        Json     @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users           User[]
  invitations     Invitation[]
  persons         Person[]
  meetings        Meeting[]
  events          Event[]
  documents       Document[]
  groups          Group[]
  notes           Note[]
  auditLogs       AuditLog[]
  passwordResets  PasswordReset[]
  applications    Application[]
  roles           ChurchRole[]
  roleGroups      RoleGroup[]
  families        Family[]
  churchDocuments ChurchDocument[]
  personAliases   PersonAlias[]
  disciplinaryMeasures DisciplinaryMeasure[]
  dataCampaigns   DataCampaign[]
  dataUpdateLinks DataUpdateLink[]
  dataUpdateSubmissions DataUpdateSubmission[]
  consents        Consent[]

  @@map("churches")
}

model User {
  id             String  @id @default(cuid())
  churchId       String
  church         Church  @relation(fields: [churchId], references: [id], onDelete: Cascade)
  /// Adresa de e-mail, stocată cu litere mici; unică în toată aplicația (un utilizator aparține unei singure biserici).
  email          String  @unique
  name           String
  passwordHash   String
  role           Role    @default(VIZUALIZARE)
  active         Boolean @default(true)
  /// Crește la schimbarea parolei / dezactivare, invalidând sesiunile emise anterior.
  sessionVersion Int     @default(0)

  // Second factor: TOTP (secret encrypted at rest, see src/server/two-factor.ts) and/or a code by e-mail.
  totpSecretEnc        String?
  /// A new TOTP secret being set up; swapped into totpSecretEnc by the first valid code.
  pendingTotpSecretEnc String?
  totpEnabled          Boolean  @default(false)
  /// Last accepted TOTP time step: a code is accepted once.
  totpLastStep         Int?
  emailOtpEnabled      Boolean  @default(false)
  /// Single-use recovery codes, hashed (sha256).
  recoveryCodes        String[] @default([])

  failedLoginCount  Int       @default(0)
  lastFailedLoginAt DateTime?
  lastLoginAt       DateTime?
  /// The network part of the last login IP ("203.0.113.x"); the full address is never stored.
  lastLoginIp       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  auditLogs           AuditLog[]
  invitationsSent     Invitation[]       @relation("InvitedBy")
  passwordResets      PasswordReset[]    @relation("ResetFor")
  resetsIssued        PasswordReset[]    @relation("ResetIssuedBy")
  applicationsDecided Application[]      @relation("ApplicationDecidedBy")
  signaturesCollected MeetingSignature[] @relation("SignatureCollectedBy")
  meetingSends        MeetingSend[]
  loginChallenges     LoginChallenge[]
  churchDocuments     ChurchDocument[]
  personAliases       PersonAlias[]
  disciplinaryMeasures DisciplinaryMeasure[]
  dataCampaigns       DataCampaign[]
  submissionsDecided  DataUpdateSubmission[] @relation("SubmissionDecidedBy")
  consentsRecorded    Consent[]              @relation("ConsentRecordedBy")

  @@index([churchId])
  @@map("users")
}

model Invitation {
  id          String    @id @default(cuid())
  churchId    String
  church      Church    @relation(fields: [churchId], references: [id], onDelete: Cascade)
  email       String
  role        Role
  /// SHA-256 al tokenului din link; tokenul în clar nu se stochează.
  tokenHash   String    @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  invitedById String?
  invitedBy   User?     @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())

  @@index([churchId, createdAt])
  @@map("invitations")
}

model PasswordReset {
  id         String    @id @default(cuid())
  churchId   String
  church     Church    @relation(fields: [churchId], references: [id], onDelete: Cascade)
  userId     String
  user       User      @relation("ResetFor", fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiresAt  DateTime
  usedAt     DateTime?
  issuedById String?
  issuedBy   User?     @relation("ResetIssuedBy", fields: [issuedById], references: [id], onDelete: SetNull)
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@map("password_resets")
}

// ---------------------------------------------------------------------------
// Registrul de persoane
// ---------------------------------------------------------------------------

/// Statut art. 28: membru, aparținător (unbaptised), prieten al casei Domnului, botezat fără calitate
/// de membru, fost membru. Being a minor is computed from the birth date, not a status.
enum PersonStatus {
  MEMBRU
  APARTINATOR
  PRIETEN
  BOTEZAT_FARA_TRANSFER
  FOST_MEMBRU
}

enum Gender {
  M
  F
}

enum EntryMode {
  BOTEZ
  TRANSFER
  NASCUT_IN_BISERICA
  REPRIMIRE
  CERERE_MEMBRALITATE
  ALTUL
}

enum ExitMode {
  TRANSFER
  RETRAGERE
  DECES
  EXCLUDERE
  ALTUL
}

model Person {
  id       String @id @default(cuid())
  churchId String
  church   Church @relation(fields: [churchId], references: [id], onDelete: Cascade)

  nume         String
  prenume      String       @default("")
  statut       PersonStatus @default(MEMBRU)
  /// "Copil → Membru": set by the statute_statuses migration (Statut art. 28), listed once in Setări → Date.
  statutAjustat String?
  gen          Gender?
  familyId     String?
  family       Family?      @relation("FamilyMembers", fields: [familyId], references: [id], onDelete: SetNull)
  /// The free-text family name used before families became records; kept for one release, then dropped.
  familieVeche String       @default("")
  rudenie      String       @default("")
  dataNasterii DateTime?    @db.Date
  telefon      String       @default("")
  email        String       @default("")
  adresa       String       @default("")

  // Intrare în biserică
  dataMembru          DateTime?  @db.Date
  modIntrare          EntryMode?
  bisericaProvenienta String     @default("")
  dataBotez           DateTime?  @db.Date
  /// Baptism year: filled from dataBotez, or alone when only the year is known.
  botezAn             Int?
  /// Water baptism: church, locality and the minister who baptised (replace the old free "locBotez").
  botezBiserica       String     @default("")
  botezLocalitate     String     @default("")
  botezOficiant       String     @default("")
  dataBinecuvantare   DateTime?  @db.Date

  // Ieșire din evidență
  dataIesire         DateTime? @db.Date
  modIesire          ExitMode?
  bisericaDestinatie String    @default("")
  /// Statut art. 24 alin. 2: a withdrawal starts from a written request.
  dataCerereRetragere DateTime? @db.Date
  /// The minutes approving the entry (transfer: art. 23 alin. 3; reabilitare: art. 22 alin. 3).
  intrareMeetingId    String?
  intrareMeeting      Meeting?  @relation("PersonEntryMeeting", fields: [intrareMeetingId], references: [id], onDelete: SetNull)
  /// The minutes recording an exclusion.
  iesireMeetingId     String?
  iesireMeeting       Meeting?  @relation("PersonExitMeeting", fields: [iesireMeetingId], references: [id], onDelete: SetNull)

  // Registru (Statut art. 14 alin. 3 lit. a)
  dataCasatoriei DateTime? @db.Date
  /// Parents' names, when the parents are not persons in the register.
  numeTata       String    @default("")
  numeMama       String    @default("")
  /// Temporary absence (Statut art. 23 alin. 4–5): since when and where; cleared by "S-a întors".
  plecatDin      DateTime? @db.Date
  plecatUnde     String    @default("")

  /// Legacy free text "Slujire / responsabilități": moved into the note by the person_form_polish migration;
  /// no longer edited, kept one release (export writes it, import reads it).
  slujire   String  @default("")
  note      String  @default("")
  /// Member of the church committee (attendance rule "Comitetul", Acasă card, Persoane filter).
  inComitet Boolean @default(false)

  /// Derivat: nume, prenume, familie, telefon, e-mail — litere mici, fără diacritice (căutare).
  searchText String @default("")
  /// Derivat: cheie de ordonare alfabetică românească (A, Ă, Â, B, ..., S, Ș, T, Ț, ...).
  sortKey    String @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  meetings       MeetingAttendee[]
  groups         GroupMember[]
  mentiuni       Note[]
  documents      Document[]
  application    Application?
  roles          PersonRole[]
  headOf         Family?            @relation("FamilyHead")
  signatures     MeetingSignature[]
  aliases        PersonAlias[]
  /// Administrators only (permission `disciplina`).
  disciplinaryMeasures DisciplinaryMeasure[]
  dataUpdateLinks      DataUpdateLink[]
  dataUpdateSubmissions DataUpdateSubmission[]
  consents             Consent[]              @relation("ConsentOf")
  consentsGivenFor     Consent[]              @relation("ConsentGivenBy")
  /// Groups this person is responsible for.
  responsibleFor Group[]            @relation("GroupResponsabil")

  @@index([churchId, sortKey])
  @@index([intrareMeetingId])
  @@index([iesireMeetingId])
  @@index([churchId, familyId])
  @@index([churchId, statut])
  @@index([searchText(ops: raw("gin_trgm_ops"))], type: Gin)
  @@map("persons")
}

/// Another written form of a person's name, remembered when a "Nepotrivit" name was matched to the
/// person by hand (minutes import). `alias` is normalized: no diacritics, lower-case, words sorted.
/// Statut art. 27 alin. 3: the forms of a disciplinary measure.
enum DisciplinaryForm {
  MUSTRARE_PERSONALA
  MUSTRARE_COMITET
  RETRAGERE_DREPTURI
  SUSPENDARE
  EXCLUDERE
}

enum DisciplinaryState {
  CERCETARE
  APLICATA
  INCHEIATA
}

enum AppealResult {
  ADMISA
  RESPINSA
}

enum DisciplinaryForum {
  LOCAL
  COMUNITATE
}

/// A disciplinary measure (Statut art. 27, 271, 272). Administrators only: never shown, counted,
/// listed, exported or hinted to other roles (permission `disciplina`).
model DisciplinaryMeasure {
  id           String            @id @default(cuid())
  churchId     String
  church       Church            @relation(fields: [churchId], references: [id], onDelete: Cascade)
  personId     String
  person       Person            @relation(fields: [personId], references: [id], onDelete: Cascade)
  forma        DisciplinaryForm
  stare        DisciplinaryState @default(CERCETARE)
  dataInceput  DateTime          @db.Date
  dataSfarsit  DateTime?         @db.Date
  meetingId    String?
  meeting      Meeting?          @relation(fields: [meetingId], references: [id], onDelete: SetNull)
  motiv        String            @default("")
  decisByForum DisciplinaryForum @default(LOCAL)
  /// Hearing before the committee (Statut art. 272 lit. a): date, time, place of the convocation letter.
  audiereLa     DateTime?         @db.Date
  audiereOra    String            @default("")
  audiereLoc    String            @default("")
  /// The disciplinary minutes (art. 272 lit. c), printed only in the administrators' "PV disciplinar".
  abatere       String            @default("")
  raspuns       String            @default("")
  nuSaPrezentat Boolean           @default(false)
  incadrare     String            @default("")
  temei         String            @default("")
  /// Communication to the person (art. 27 alin. 10) and the appeal to the Comunitate (alin. 11).
  comunicatLa         DateTime?     @db.Date
  contestatieLa       DateTime?     @db.Date
  contestatieRezultat AppealResult?
  /// Reinstatement (art. 271): the written request and the committee minutes.
  cerereRepunereLa  DateTime? @db.Date
  repunereMeetingId String?
  repunereMeeting   Meeting?  @relation("DisciplineReinstatement", fields: [repunereMeetingId], references: [id], onDelete: SetNull)
  createdById  String?
  createdBy    User?             @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([churchId, personId])
  @@index([personId])
  @@index([meetingId])
  @@index([repunereMeetingId])
  @@map("disciplinary_measures")
}

enum CampaignStatus {
  ACTIVE
  CLOSED
}

/// A "data update" campaign: adults check their own data and their minor children's through a
/// personal link (or a general link / QR code), give or refuse the optional consents; the secretary
/// approves the changes. Tokens are never stored: see src/server/campaign-tokens.ts.
model DataCampaign {
  id                 String         @id @default(cuid())
  churchId           String
  church             Church         @relation(fields: [churchId], references: [id], onDelete: Cascade)
  nume               String
  deadline           DateTime       @db.Date
  status             CampaignStatus @default(ACTIVE)
  generalLinkEnabled Boolean        @default(false)
  /// The general link: its token is an HMAC of the campaign id and this nonce; only the hash is looked up.
  generalNonce       String?
  generalTokenHash   String?        @unique
  /// sha256 of the privacy notice text when the campaign started (the consents' textVersion).
  privacyTextVersion String
  createdAt          DateTime       @default(now())
  createdById        String?
  createdBy          User?          @relation(fields: [createdById], references: [id], onDelete: SetNull)
  closedAt           DateTime?

  links       DataUpdateLink[]
  submissions DataUpdateSubmission[]

  @@index([churchId, createdAt])
  @@map("data_campaigns")
}

/// One adult's personal link in a campaign.
model DataUpdateLink {
  id           String       @id @default(cuid())
  churchId     String
  church       Church       @relation(fields: [churchId], references: [id], onDelete: Cascade)
  campaignId   String
  campaign     DataCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  personId     String
  person       Person       @relation(fields: [personId], references: [id], onDelete: Cascade)
  /// The token is an HMAC of the link id and this nonce (reproducible for "Copiază linkul"); a new
  /// link gets a new nonce. Only the sha256 of the token is looked up.
  nonce        String
  tokenHash    String       @unique
  expiresAt    DateTime
  sentAt       DateTime?
  openedAt     DateTime?
  verifiedAt   DateTime?
  failedChecks Int          @default(0)
  lockedAt     DateTime?
  submittedAt  DateTime?
  revokedAt    DateTime?
  createdAt    DateTime     @default(now())

  submissions DataUpdateSubmission[]

  @@unique([campaignId, personId])
  @@index([churchId])
  @@index([personId])
  @@map("data_update_links")
}

enum SubmissionVia {
  PERSONAL
  GENERAL
}

enum SubmissionStatus {
  PENDING
  ACCEPTED
  PARTIAL
  REJECTED
}

/// What an adult sent through a campaign link: their own data and their minor children's (only the
/// campaign's fields), the answers to the consents for the general link. Reaches the register only
/// when the secretary approves it.
model DataUpdateSubmission {
  id          String           @id @default(cuid())
  churchId    String
  church      Church           @relation(fields: [churchId], references: [id], onDelete: Cascade)
  campaignId  String
  campaign    DataCampaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  linkId      String?
  link        DataUpdateLink?  @relation(fields: [linkId], references: [id], onDelete: SetNull)
  /// The adult (personal link) or the person the general link matched; null = not matched.
  personId    String?
  person      Person?          @relation(fields: [personId], references: [id], onDelete: SetNull)
  via         SubmissionVia
  /// src/lib/schemas/data-update.ts (DataUpdateProposal)
  proposed    Json
  status      SubmissionStatus @default(PENDING)
  decidedAt   DateTime?
  decidedById String?
  decidedBy   User?            @relation("SubmissionDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)
  note        String           @default("")
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  consents Consent[]

  @@index([churchId, status])
  @@index([campaignId])
  @@index([personId])
  @@map("data_update_submissions")
}

enum ConsentKind {
  INFO_NOTE
  PHOTOS
  BIRTHDAY
  CONTACT
  DIRECTORY
}

enum ConsentSource {
  ONLINE
  PAPER
  STAFF
}

/// One answer to the privacy notice or an optional consent; the current one is the latest per kind.
model Consent {
  id              String                @id @default(cuid())
  churchId        String
  church          Church                @relation(fields: [churchId], references: [id], onDelete: Cascade)
  personId        String
  person          Person                @relation("ConsentOf", fields: [personId], references: [id], onDelete: Cascade)
  kind            ConsentKind
  granted         Boolean
  /// The notice version the answer refers to (the campaign's privacyTextVersion, or the paper form's).
  textVersion     String                @default("")
  givenAt         DateTime
  source          ConsentSource
  /// The parent who answered for a minor.
  givenByPersonId String?
  givenBy         Person?               @relation("ConsentGivenBy", fields: [givenByPersonId], references: [id], onDelete: SetNull)
  submissionId    String?
  submission      DataUpdateSubmission? @relation(fields: [submissionId], references: [id], onDelete: SetNull)
  withdrawnAt     DateTime?
  createdById     String?
  createdBy       User?                 @relation("ConsentRecordedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt       DateTime              @default(now())

  @@index([churchId, kind])
  @@index([personId, kind])
  @@index([submissionId])
  @@map("consents")
}

model PersonAlias {
  id          String   @id @default(cuid())
  churchId    String
  church      Church   @relation(fields: [churchId], references: [id], onDelete: Cascade)
  personId    String
  person      Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  alias       String
  createdAt   DateTime @default(now())
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([churchId, alias])
  @@index([churchId])
  @@index([personId])
  @@map("person_aliases")
}

/// A family, defined by its head. Members point to it through Person.familyId.
model Family {
  id          String  @id @default(cuid())
  churchId    String
  church      Church  @relation(fields: [churchId], references: [id], onDelete: Cascade)
  /// Display name, by default "Fam. <Prenume Nume of the head>".
  nume        String
  headId      String? @unique
  head        Person? @relation("FamilyHead", fields: [headId], references: [id], onDelete: SetNull)
  adresa      String  @default("")
  note        String  @default("")
  /// Created automatically (migration or import from family text), still with its default name and
  /// never edited; "Dizolvă familiile create automat" and "Recalculează capii de familie" act only on these.
  autoCreated Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members Person[] @relation("FamilyMembers")

  @@index([churchId, nume])
  @@map("families")
}

/// A function held in the church (Pastor, Diacon, Lider tineret …): the church's own nomenclature.
model ChurchRole {
  id        String    @id @default(cuid())
  churchId  String
  church    Church    @relation(fields: [churchId], references: [id], onDelete: Cascade)
  nume      String
  sortOrder Int       @default(0)
  groupId   String
  group     RoleGroup @relation(fields: [groupId], references: [id], onDelete: Restrict)
  /// Inactive roles stay on the persons that hold them but cannot be newly assigned.
  active    Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  holders   PersonRole[]
  /// Groups of this ministry, and groups led by this role's holders.
  groups    Group[]      @relation("GroupFunctie")
  ledGroups Group[]      @relation("GroupFunctieLider")

  @@unique([churchId, nume])
  @@index([churchId, sortOrder])
  @@index([groupId])
  @@map("church_roles")
}

/// A group of the church's role nomenclature ("Funcții", "Slujiri", …), shown as one block on the person form.
model RoleGroup {
  id        String  @id @default(cuid())
  churchId  String
  church    Church  @relation(fields: [churchId], references: [id], onDelete: Cascade)
  nume      String
  sortOrder Int     @default(0)
  /// An inactive group is hidden from the person form; it cannot be deactivated while it has active entries.
  active    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roles ChurchRole[]

  @@unique([churchId, nume])
  @@index([churchId, sortOrder])
  @@map("role_groups")
}

/// A role held by a person. No churchId: reached only through Person or ChurchRole (like GroupMember).
model PersonRole {
  personId String
  roleId   String
  person   Person     @relation(fields: [personId], references: [id], onDelete: Cascade)
  role     ChurchRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
  since    DateTime?  @db.Date
  until    DateTime?  @db.Date

  @@id([personId, roleId])
  @@index([roleId])
  @@map("person_roles")
}

// ---------------------------------------------------------------------------
// Procese-verbale
// ---------------------------------------------------------------------------

model Meeting {
  id       String @id @default(cuid())
  churchId String
  church   Church @relation(fields: [churchId], references: [id], onDelete: Cascade)

  titlu            String   @default("")
  tip              String
  data             DateTime @db.Date
  /// Ora în format HH:MM (sau șir gol).
  ora              String   @default("")
  loc              String   @default("")
  presedinte       String   @default("")
  invitati         String   @default("")
  ordine           String   @default("")
  discutii         String   @default("")
  hotarari         String   @default("")
  /// Number in the minutes register of the year `anRegistru` (the year of `data`); null = not numbered yet.
  nr               Int?
  anRegistru       Int?
  /// "Puncte discutate și aprobate", in order. Replaces the free texts discutii/hotarari (migrated into puncte/observatii).
  puncte           String[] @default([])
  observatii       String   @default("")
  formulaIncheiere String   @default("Toate punctele au fost votate în unanimitate de membrii prezenți.")
  /// Rich versions from the editor (src/lib/rich-text.ts); the plain fields above keep their projection.
  /// puncteRich is an array with one document per point, in the order of `puncte`.
  puncteRich       Json?
  observatiiRich   Json?
  formulaRich      Json?
  /// How many persons the type's attendance rule expected when the meeting was saved (null: manual type or saved before the rules).
  asteptati        Int?
  /// General Assembly (Statut art. 46): when it was announced, its scope, ordinary / extraordinary,
  /// convened by the Comunitate (art. 461: 7 days instead of 14).
  convocatLa            DateTime?          @db.Date
  convocareText         String             @default("")
  tipAG                 GeneralAssemblyKind?
  convocataDeComunitate Boolean            @default(false)
  /// Votes per point, aligned with `puncte`: {pentru, contra, abtineri, secret} or null (src/lib/general-assembly.ts).
  voturi                Json?
  /// This meeting's own page layout (src/lib/page-layout.ts); null = the church's default.
  layout           Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  disciplinaryMeasures DisciplinaryMeasure[]
  reinstatements       DisciplinaryMeasure[] @relation("DisciplineReinstatement")
  /// Persons whose entry / exclusion these minutes record.
  entries Person[] @relation("PersonEntryMeeting")
  exits   Person[] @relation("PersonExitMeeting")

  /// A closed (signed) meeting is read-only until an administrator reopens it.
  locked   Boolean   @default(false)
  lockedAt DateTime?

  prezenti   MeetingAttendee[]
  signatures MeetingSignature[]
  sends      MeetingSend[]

  @@unique([churchId, anRegistru, nr])
  @@index([churchId, data])
  @@map("meetings")
}

/// The handwritten signature of a person present at a meeting (PNG, at most 600×200 and 40 KB). Reached only through Meeting.
model MeetingSignature {
  id             String   @id @default(cuid())
  meetingId      String
  meeting        Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  personId       String
  person         Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  imagePng       Bytes
  signedAt       DateTime @default(now())
  signedByUserId String?
  signedBy       User?    @relation("SignatureCollectedBy", fields: [signedByUserId], references: [id], onDelete: SetNull)

  @@unique([meetingId, personId])
  @@map("meeting_signatures")
}

/// The second step of a login, after a correct password: identified by a random token kept in an
/// httpOnly cookie (only its hash is stored). Used with the global client (authentication).
model LoginChallenge {
  id                 String    @id @default(cuid())
  tokenHash          String    @unique
  userId             String
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt          DateTime  @default(now())
  expiresAt          DateTime
  /// Wrong codes so far; at 5 the challenge is deleted and the login starts again.
  attempts           Int       @default(0)
  /// The e-mail code (hashed) and its expiry, when one was sent.
  emailCodeHash      String?
  emailCodeExpiresAt DateTime?
  /// The church requires a second factor and the user has none: setup first.
  setupRequired      Boolean   @default(false)
  /// Set when the code was accepted; the challenge is then consumed by the sign-in.
  verifiedAt         DateTime?
  callbackUrl        String    @default("/")

  @@index([userId])
  @@map("login_challenges")
}

enum ChurchDocumentKind {
  STATUT_CULT
  STATUT_INTERN
}

/// A PDF the church publishes on its application form (the statutes), stored in the database.
model ChurchDocument {
  id           String             @id @default(cuid())
  churchId     String
  church       Church             @relation(fields: [churchId], references: [id], onDelete: Cascade)
  kind         ChurchDocumentKind
  fileName     String
  size         Int
  pdf          Bytes
  uploadedAt   DateTime           @default(now())
  uploadedById String?
  uploadedBy   User?              @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@unique([churchId, kind])
  @@index([churchId])
  @@map("church_documents")
}

enum MeetingSendStatus {
  SENT
  FAILED
}

/// One e-mail of the minutes (child of Meeting, no churchId: reach it through the meeting).
model MeetingSend {
  id           String            @id @default(cuid())
  meetingId    String
  meeting      Meeting           @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  /// Recipients, lower-case and deduplicated.
  to           String[]
  sentAt       DateTime          @default(now())
  sentByUserId String?
  sentBy       User?             @relation(fields: [sentByUserId], references: [id], onDelete: SetNull)
  /// Id returned by the e-mail provider.
  resendId     String?
  status       MeetingSendStatus
  /// Short, user-readable reason when the send failed.
  error        String?

  @@index([meetingId, sentAt])
  @@map("meeting_sends")
}

enum AttendanceStatus {
  PRESENT
  ABSENT
}

/// A person on a meeting's attendance list: present, or absent (expected by the type's rule but not present).
model MeetingAttendee {
  meetingId String
  personId  String
  meeting   Meeting          @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  person    Person           @relation(fields: [personId], references: [id], onDelete: Cascade)
  status    AttendanceStatus @default(PRESENT)
  /// An absence excused (committee meetings, Statut art. 45): not counted towards 5 in a row.
  motivat   Boolean          @default(false)

  @@id([meetingId, personId])
  @@index([personId])
  @@map("meeting_attendees")
}

// ---------------------------------------------------------------------------
// Calendar
// ---------------------------------------------------------------------------

model Event {
  id       String @id @default(cuid())
  churchId String
  church   Church @relation(fields: [churchId], references: [id], onDelete: Cascade)

  titlu       String
  tip         String
  data        DateTime @db.Date
  ora         String   @default("")
  loc         String   @default("")
  invitat     String   @default("")
  responsabil String   @default("")
  descriere   String   @default("")

  agapaActiva      Boolean @default(false)
  agapaResponsabil String  @default("")
  agapaPersoane    Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contributii EventContribution[]

  @@index([churchId, data])
  @@map("events")
}

/// „Cine aduce ce” la agapă.
model EventContribution {
  id      String @id @default(cuid())
  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  pozitie Int
  cine    String @default("")
  ce      String @default("")

  @@index([eventId, pozitie])
  @@map("event_contributions")
}

// ---------------------------------------------------------------------------
// Registrul de ieșire (documente)
// ---------------------------------------------------------------------------

enum DocumentType {
  adeverinta
  botez
  binecuvantare
  recomandare
  scrisoare
  raport
  /// "Convocare Adunare Generală" (Statut art. 46), generated from a meeting.
  convocare
}

enum GeneralAssemblyKind {
  ORDINARA
  EXTRAORDINARA
}

model Document {
  id       String @id @default(cuid())
  churchId String
  church   Church @relation(fields: [churchId], references: [id], onDelete: Cascade)

  tip        DocumentType
  /// A recommendation issued during a disciplinary investigation under the domicile exception (Statut art. 27 alin. 6).
  exceptieDomiciliu Boolean @default(false)
  /// Numărul de înregistrare; unic pe biserică și an.
  nr         Int
  /// Anul registrului (anul din `data`), folosit pentru numerotarea pe an.
  anRegistru Int
  data       DateTime     @db.Date

  personId String?
  person   Person? @relation(fields: [personId], references: [id], onDelete: SetNull)
  /// Numele persoanei la momentul emiterii (rămâne și dacă persoana e ștearsă din registru).
  persoana String  @default("")

  catre    String @default("")
  scop     String @default("")
  titlu    String @default("")
  text     String
  /// The rich version from the editor (src/lib/rich-text.ts); `text` keeps its plain projection.
  textRich Json?
  /// This document's own page layout; null = the church's default (docLayout).
  layout   Json?

  /// Pentru darea de seamă: anul raportat.
  anRaport Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([churchId, anRegistru, nr])
  @@index([churchId, data])
  @@index([personId])
  @@map("documents")
}

// ---------------------------------------------------------------------------
// Grupuri și mențiuni
// ---------------------------------------------------------------------------

model Group {
  id       String @id @default(cuid())
  churchId String
  church   Church @relation(fields: [churchId], references: [id], onDelete: Cascade)

  nume          String
  /// The responsible person's name as text: the fallback for display and older exports (kept equal to the person's name when linked).
  responsabil   String  @default("")
  /// The responsible person, from the register.
  responsabilId String?
  responsabilP  Person? @relation("GroupResponsabil", fields: [responsabilId], references: [id], onDelete: SetNull)
  descriere     String  @default("")

  /// The ministry the group belongs to (e.g. "Laudă și închinare"): its holders are the group's automatic members.
  functieId      String?
  functie        ChurchRole? @relation("GroupFunctie", fields: [functieId], references: [id], onDelete: SetNull)
  /// The role whose holders lead the group (e.g. "Lider laudă și închinare").
  functieLiderId String?
  functieLider   ChurchRole? @relation("GroupFunctieLider", fields: [functieLiderId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  membri GroupMember[]

  @@index([functieId])
  @@index([functieLiderId])
  @@index([responsabilId])
  @@index([churchId, nume])
  @@map("groups")
}

/// How a person is in a group: kept in sync from the group's roles (AUTO) or added by hand (MANUAL).
enum GroupMemberSource {
  AUTO
  MANUAL
}

model GroupMember {
  groupId  String
  personId String
  group    Group             @relation(fields: [groupId], references: [id], onDelete: Cascade)
  person   Person            @relation(fields: [personId], references: [id], onDelete: Cascade)
  /// AUTO rows are added and removed by syncRoleGroups (src/server/group-sync.ts); MANUAL rows never are.
  sursa    GroupMemberSource @default(MANUAL)

  @@id([groupId, personId])
  @@index([personId])
  @@map("group_members")
}

model Note {
  id       String @id @default(cuid())
  churchId String
  church   Church @relation(fields: [churchId], references: [id], onDelete: Cascade)

  data     DateTime @db.Date
  tip      String
  personId String?
  person   Person?  @relation(fields: [personId], references: [id], onDelete: SetNull)
  familie  String   @default("")
  text     String

  /// Derivat: text, tip și familie — litere mici, fără diacritice (căutare).
  searchText String @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([churchId, data])
  @@index([personId])
  @@index([searchText(ops: raw("gin_trgm_ops"))], type: Gin)
  @@map("notes")
}

// ---------------------------------------------------------------------------
// Jurnal de modificări
// ---------------------------------------------------------------------------

enum AuditEntity {
  PERSON
  DOCUMENT
  MEETING
  EVENT
  GROUP
  NOTE
  SETTINGS
  USER
  IMPORT
  APPLICATION
  CHURCH_ROLE
  FAMILY
  EXTRACT
  SECURITY
  /// Visible only with the `disciplina` permission (administrators).
  DISCIPLINE
  /// Data-update campaigns (links, submissions, consents).
  CAMPAIGN
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
}

model AuditLog {
  id       String @id @default(cuid())
  churchId String
  church   Church @relation(fields: [churchId], references: [id], onDelete: Cascade)

  userId   String?
  user     User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// Numele utilizatorului la momentul modificării.
  userName String  @default("")

  entity      AuditEntity
  entityId    String
  /// Eticheta înregistrării (ex. numele persoanei), păstrată și după ștergere.
  entityLabel String      @default("")
  action      AuditAction
  /// Pentru UPDATE: { câmp: [înainte, după] }; pentru CREATE/DELETE: instantaneul câmpurilor.
  changes     Json?

  createdAt DateTime @default(now())

  @@index([churchId, entity, entityId, createdAt])
  @@index([churchId, createdAt])
  @@map("audit_logs")
}

enum ApplicationStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum ApplicationKind {
  TRANSFER
  BOTEZ
  CERERE_MEMBRALITATE
  ALTUL
}

/// Membership application sent through the public form /cerere/<slug>.
model Application {
  id       String @id @default(cuid())
  churchId String
  church   Church @relation(fields: [churchId], references: [id], onDelete: Cascade)

  status ApplicationStatus @default(PENDING)
  kind   ApplicationKind

  nume                String
  prenume             String    @default("")
  gen                 Gender?
  dataNasterii        DateTime? @db.Date
  telefon             String    @default("")
  email               String    @default("")
  adresa              String    @default("")
  familie             String    @default("")
  rudenie             String    @default("")
  bisericaProvenienta String    @default("")
  dataBotez           DateTime? @db.Date
  botezAn             Int?
  botezBiserica       String    @default("")
  botezLocalitate     String    @default("")
  botezOficiant       String    @default("")
  mesaj               String    @default("")
  /// The applicant agreed that the church keeps the data for its membership records.
  consent             Boolean   @default(false)
  /// The applicant read and accepted the statutes the church had published when applying.
  consentStatutCult   Boolean   @default(false)
  consentStatutIntern Boolean   @default(false)
  consentAt           DateTime?

  createdAt    DateTime  @default(now())
  decidedAt    DateTime?
  decidedById  String?
  decidedBy    User?     @relation("ApplicationDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)
  /// The person created in the register when the application was accepted.
  personId     String?   @unique
  person       Person?   @relation(fields: [personId], references: [id], onDelete: SetNull)
  rejectReason String    @default("")

  @@index([churchId, status, createdAt])
  @@map("applications")
}
